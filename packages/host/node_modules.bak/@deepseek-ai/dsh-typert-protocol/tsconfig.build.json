{
  // dsh-gitkit 新增（非上游文件）：为 vendored 副本补声明/JS 构建——上游 npm 发布物自带 lib/，
  // 而本仓库 .gitignore 排除 lib/，全新 checkout（CI）需要先构建本包才能 typecheck/test
  // （types 字段与 exports 均指向 lib/types/*.d.ts；vitest 运行时也经 junction 解析 lib/index.js）。
  // 布局照上游构建产物实证：outDir=lib（*.js）、declarationDir=lib/types（*.d.ts）、rootDir=src。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src"]
}
