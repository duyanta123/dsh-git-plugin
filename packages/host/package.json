{
  "name": "dsh-gitkit",
  "version": "0.4.0-rc.0",
  "description": "dsh Git 插件（DeepSeek Harness）——单包双面：Node 侧 RPC 服务（status/diff/stage/commit/push/log/...）+ Web 侧界面（header 入口 / 变更审查 tab / 提交图 tab）；接口权威 = docs/capability-spec.md §①§③",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./errors": {
      "types": "./lib/error-codes.d.ts"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/*.d.ts",
    "lib/error-codes.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/client.js",
    "lib/client/**/*.d.ts",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.5 || ^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@tanstack/react-virtual": "3.14.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "18.2.0",
    "chokidar": "^5.0.0",
    "immer": "^10.1.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "rolldown": "1.2.7",
    "tsdown": "^0.22.2",
    "zustand": "~4.5.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyanta123/dsh-git-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/duyanta123/dsh-git-plugin/issues"
  },
  "homepage": "https://github.com/duyanta123/dsh-git-plugin#readme"
}
