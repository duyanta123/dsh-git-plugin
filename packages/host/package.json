{
  "name": "dsh-gitkit",
  "version": "0.2.0",
  "description": "dsh Git 插件 host 半（node 侧 RPC 服务：status/diff/stage/commit/push/log/...）；接口权威 = docs/capability-spec.md §①",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./errors": {
      "types": "./lib/error-codes.d.ts"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/*.d.ts",
    "lib/error-codes.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.5 || ^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "chokidar": "^5.0.0",
    "tsdown": "^0.22.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyanta123/dsh-git-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/duyanta123/dsh-git-plugin/issues"
  },
  "homepage": "https://github.com/duyanta123/dsh-git-plugin#readme",
  "prepack": "pnpm -w run build"
}
