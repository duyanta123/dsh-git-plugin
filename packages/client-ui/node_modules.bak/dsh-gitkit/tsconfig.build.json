{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // 只补 .d.ts：lib JS 由 tsdown 打包（tsdown.config.ts，含 typertPlugin 产物），
    // 本工程在其后运行，仅产出声明文件（allowImportingTsExtensions 要求
    // noEmit 或 emitDeclarationOnly 二选一）。
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": false,
    // 声明构建不继承 base 的 paths 源平面（源平面把 protocol 的 .ts 源拉进程序，
    // 触发 rootDir TS6059）；这里回落 node_modules 解析（vendored 包的 lib/types d.ts，
    // tsconfig 继承是整值替换，空对象即清空映射）。
    "paths": {}
  },
  "include": ["src"]
}
