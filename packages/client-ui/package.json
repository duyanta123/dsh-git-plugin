{
  "name": "dsh-gitkit-ui",
  "version": "0.2.0",
  "description": "dsh Git 插件 client 半（web 面：header 入口 / 变更审查 tab / 提交图 tab）；接口权威 = docs/capability-spec.md §③",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-gitkit",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "dsh-gitkit": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "18.2.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "rolldown": "1.2.7",
    "lightningcss": "^1.33.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "zustand": "~4.5.7",
    "immer": "^10.1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyanta123/dsh-git-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/duyanta123/dsh-git-plugin/issues"
  },
  "homepage": "https://github.com/duyanta123/dsh-git-plugin#readme",
  "prepack": "pnpm -w run build"
}
